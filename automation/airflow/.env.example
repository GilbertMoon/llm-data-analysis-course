# Chapter 14 Docker Compose based Airflow learning environment.
#
# 1. Copy this file to .env.
# 2. Fill every empty secret value before starting.
# 3. Never commit the real .env file.
#
# Windows Docker Desktop can normally keep AIRFLOW_UID=50000.
# On macOS/Linux, set AIRFLOW_UID to the output of: id -u

AIRFLOW_UID=50000
AIRFLOW_PROJECT_DIR=../..
AIRFLOW_VERSION=3.3.0
AIRFLOW_UI_PORT=8080

# Airflow stores timestamps internally in UTC. The learning DAG displays
# its schedule in Asia/Seoul while the platform default remains UTC.
AIRFLOW_DEFAULT_TIMEZONE=utc
AIRFLOW_DAG_TIMEZONE=Asia/Seoul

# Required secrets. Keep these values empty in the example file.
# Fill them only in the untracked .env file with different random values.
AIRFLOW_DB_PASSWORD=
AIRFLOW_API_JWT_SECRET=

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=

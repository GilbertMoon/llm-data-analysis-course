# Chapter 14 Docker Compose 기반 Airflow 실습 환경변수 예시
#
# 사용 방법:
#   cd automation/airflow
#   cp .env.example .env
#
# Windows Docker Desktop에서는 보통 AIRFLOW_UID=50000 그대로 사용해도 됩니다.
# macOS/Linux에서는 필요한 경우 `echo "AIRFLOW_UID=$(id -u)" > .env` 방식으로 조정할 수 있습니다.

AIRFLOW_UID=50000
AIRFLOW_PROJECT_DIR=../..
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow
